#!/bin/bash

# 1. 统计 .md 文件数量
files=$(find . -type f -name "*.md" ! -path "./.git/*" ! -path "./node_modules/*" | wc -l)

# 2. 统计总字数（字符数，含中文）
words=$(find . -type f -name "*.md" ! -path "./.git/*" ! -path "./node_modules/*" -exec cat {} \; | wc -m)

# 3. 统计分类数（从 front matter 的 categories 字段提取并去重）
# 临时文件存储所有分类
tmp_cats=$(mktemp)
# 遍历所有 .md 文件，提取 categories 行
find . -type f -name "*.md" ! -path "./.git/*" ! -path "./node_modules/*" | while read -r file; do
    # 取第一个出现的 categories: 行，并去掉前缀
    grep -m1 '^categories:' "$file" | sed 's/^categories:[[:space:]]*//' | while read -r line; do
        # 去除方括号，将逗号替换为空格，再按空格拆分
        echo "$line" | sed 's/\[//g; s/\]//g' | tr ',' ' ' | tr -s ' ' | while read -r cat; do
            for c in $cat; do
                echo "$c"
            done
        done
    done
done > "$tmp_cats"
# 去重并计数（排除空行）
categories=$(sort -u "$tmp_cats" | grep -v '^$' | wc -l)
rm -f "$tmp_cats"

# 4. 获取最后一次提交的 ISO 时间
updated=$(git log -1 --format=%cd --date=iso)

# 5. 统计总提交次数
commits=$(git rev-list --count HEAD)

# 生成 JSON 文件
cat > stats.json << EOF
{
  "files": $files,
  "words": $words,
  "categories": $categories,
  "updated": "$updated",
  "commits": $commits
}
EOF

echo "✅ 统计完成：$files 篇文章，$words 字，$categories 个分类，$commits 次提交，最后更新于 $updated"